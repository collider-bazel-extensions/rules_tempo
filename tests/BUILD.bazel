"""Tests for rules_tempo.

- Analysis test verifies the macro instantiates cleanly.
- Smoke composition: kind cluster + Tempo (single-binary, OTLP receiver).
  Smoke `kubectl run`s a curl pod, POSTs an OTLP/JSON trace at
  `tempo:4318/v1/traces`, then GETs the trace back via
  `tempo:3200/api/traces/<traceId>` and asserts both the trace ID and
  one span attribute round-tripped — proves the OTLP receiver +
  ingester WAL + queryFrontend + querier path end-to-end.
"""

load("@rules_itest//:itest.bzl", "itest_service", "service_test")
load("@rules_kind//:defs.bzl", "kind_cluster", "kind_health_check")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_tempo//:defs.bzl", "tempo_health_check", "tempo_install")
load(":analysis_tests.bzl", "tempo_install_test_suite")

# ---- analysis ---------------------------------------------------------------

tempo_install_test_suite(name = "tempo_install_analysis")

# ---- smoke composition ------------------------------------------------------

kind_cluster(name = "cluster", k8s_version = "1.32")
kind_health_check(name = "cluster_health", cluster = ":cluster")
itest_service(
    name = "kind_svc",
    exe = ":cluster",
    health_check = ":cluster_health",
    tags = ["manual"],
)

tempo_install(
    name = "tempo_install_bin",
    tags = ["manual"],
)

tempo_health_check(
    name = "tempo_health_bin",
    tags = ["manual"],
)

sh_binary(
    name = "tempo_install_wrapper",
    srcs = ["install_wrapper.sh"],
    data = [":tempo_install_bin"],
)

sh_binary(
    name = "tempo_health_wrapper",
    srcs = ["health_wrapper.sh"],
    data = [":tempo_health_bin"],
)

itest_service(
    name = "tempo_svc",
    exe = ":tempo_install_wrapper",
    deps = [":kind_svc"],
    health_check = ":tempo_health_wrapper",
    tags = ["manual"],
)

sh_test(
    name = "smoke_test_bin",
    srcs = ["smoke_test.sh"],
    tags = ["manual"],
)

service_test(
    name = "smoke_test",
    services = [":tempo_svc"],
    test = ":smoke_test_bin",
    tags = [
        "manual",
        "no-sandbox",
        "requires-network",
    ],
)
